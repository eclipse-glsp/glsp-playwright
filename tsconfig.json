{
  "extends": "@eclipse-glsp/ts-config/tsconfig.json",
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["ES2019", "DOM"],
    "types": ["node"],
    "composite": true
  },
  "exclude": ["**/node_modules"],
  "include": [
    "packages/*/src",
    "examples/*/src",
    "examples/*/tests",
    "examples/*/*.config.ts",
    "examples/*/configs/*.ts"
  ],
  "references": [
    { "path": "./packages/playwright" },
    { "path": "./packages/playwright-theia" },
    { "path": "./packages/playwright-vscode" },
    { "path": "./examples/workflow" },
    { "path": "./examples/workflow-theia" },
    { "path": "./examples/workflow-vscode" }
  ]
}
